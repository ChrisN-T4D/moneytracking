# PocketBase — set your instance URL (never commit .env.local)
# Copy to .env.local and fill in your URL
NEXT_PUBLIC_POCKETBASE_URL=https://your-pocketbase-instance.com

# Optional: use a different base URL for the setup API (admin auth). Set only if your API
# is at the root while the admin UI is at a subpath (e.g. https://your-pb.com/_/).
# POCKETBASE_API_URL=https://your-pocketbase-instance.com

# Required for /setup (create collections and seed from the website):
POCKETBASE_ADMIN_EMAIL=your-admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Optional: Ollama on neu2 for Analyze tab (paycheck brief + chat)
# OLLAMA_BASE_URL=http://192.168.50.112:11434
# OLLAMA_MODEL=qwythos:9b
